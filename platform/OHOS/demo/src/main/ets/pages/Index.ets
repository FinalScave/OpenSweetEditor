import {
  CodeLensClickEvent,
  CursorChangedEvent,
  CurrentLineRenderMode,
  Document,
  FoldArrowMode,
  InlayHintClickEvent,
  InlayType,
  InlineSuggestion,
  InlineSuggestionListener,
  SearchRequest,
  SearchState,
  SearchStatus,
  SelectionChangedEvent,
  SweetEditor,
  SweetEditorController,
  WrapMode,
  createEmptySearchState
} from '@qiplat/sweeteditor';
import { resourceManager } from '@kit.LocalizationKit';
import { util } from '@kit.ArkTS';
import { window } from '@kit.ArkUI';
import { DemoCompletionProvider } from '../demo/DemoCompletionProvider';
import { DemoDecorationProvider } from '../demo/DemoDecorationProvider';
import {
  createDemoFileMetadata,
  createDemoTheme,
  createLanguageConfiguration,
  DEMO_RAWFILE_ROOT,
  FALLBACK_FILE_NAME,
  FALLBACK_TEXT
} from '../demo/DemoSamples';

const DARK_PAGE_BG: string = '#11141A';
const DARK_PANEL: string = '#171B22';
const DARK_PANEL_STRONG: string = '#202631';
const DARK_TEXT_PRIMARY: string = '#E7EDF5';
const DARK_TEXT_SECONDARY: string = '#7F8A9A';
const DARK_BORDER: string = '#2A303B';

const LIGHT_PAGE_BG: string = '#F3F6FA';
const LIGHT_PANEL: string = '#FFFFFF';
const LIGHT_PANEL_STRONG: string = '#EDF2F7';
const LIGHT_TEXT_PRIMARY: string = '#18202A';
const LIGHT_TEXT_SECONDARY: string = '#788394';
const LIGHT_BORDER: string = '#D7DEE8';

const ACCENT: string = '#4A8F7A';
const INLINE_SUGGESTION_DELAY_MS = 1000;
const DEMO_INLINE_SUGGESTION_TEXT = '\nvoid autoGenerated() {\n    std::cout << "hello" << std::endl;\n    return;\n}';
const CODELENS_RUN_COMMAND_ID = 1;
const CODELENS_DEBUG_COMMAND_ID = 2;

interface HostContextWithResourceManager {
  resourceManager: resourceManager.ResourceManager;
}

class DemoSelectOption implements SelectOption {
  value: ResourceStr;

  constructor(value: ResourceStr) {
    this.value = value;
  }
}

class DemoInlineSuggestionStatusListener implements InlineSuggestionListener {
  private readonly statusUpdater: (message: string) => void;

  constructor(statusUpdater: (message: string) => void) {
    this.statusUpdater = statusUpdater;
  }

  onSuggestionAccepted(suggestion: InlineSuggestion): void {
    this.statusUpdater(`Accepted suggestion at line ${suggestion.line + 1}`);
  }

  onSuggestionDismissed(suggestion: InlineSuggestion): void {
    this.statusUpdater(`Dismissed suggestion at line ${suggestion.line + 1}`);
  }
}

@Entry
@Component
struct Index {
  @State topPadding: number = 0;
  @State statusMessage: string = 'Ready';
  @State isDarkTheme: boolean = true;
  @State selectedWrapMode: WrapMode = WrapMode.NONE;
  @State selectedFileIndex: number = 0;
  @State fileOptions: SelectOption[] = [];
  @State fileNames: string[] = [];
  @State activeFileName: string = '';
  @State searchVisible: boolean = false;
  @State replaceVisible: boolean = false;
  @State searchText: string = '';
  @State replaceText: string = '';
  @State searchCaseSensitive: boolean = false;
  @State searchWholeWord: boolean = false;
  @State searchUseRegex: boolean = false;
  @State searchState: SearchState = createEmptySearchState();

  private readonly editorController: SweetEditorController = new SweetEditorController();
  private readonly demoCompletionProvider: DemoCompletionProvider = new DemoCompletionProvider();
  private readonly demoDecorationProvider: DemoDecorationProvider = new DemoDecorationProvider(
    () => this.editorController.getDocument()
  );
  private readonly textDecoder: util.TextDecoder = util.TextDecoder.create('utf-8', { ignoreBOM: true });
  private editorConfigured: boolean = false;
  private decorationProviderAdded: boolean = false;
  private completionProviderAdded: boolean = false;
  private subscribedEvents: boolean = false;
  private selectionActive: boolean = false;
  private pendingSuggestionTimerId: number = -1;

  aboutToAppear(): void {
    this.editorController.whenReady(() => {
      void this.initializeEditorDemo();
    });

    const uiContext = this.getUIContext();
    const hostContext = uiContext.getHostContext();
    if (!hostContext) {
      this.applyFallbackFileList();
      return;
    }

    void this.loadFileList();
    window.getLastWindow(hostContext).then((win) => {
      const avoidArea = win.getWindowAvoidArea(window.AvoidAreaType.TYPE_SYSTEM);
      this.topPadding = uiContext.px2vp(avoidArea.topRect.height);
    }).catch(() => {
    });
  }

  private async initializeEditorDemo(): Promise<void> {
    const manager = this.getResourceManager();
    if (manager) {
      try {
        await DemoDecorationProvider.ensureSweetLineReady(manager);
      } catch (_e) {
        this.statusMessage = 'SweetLine init failed';
      }
    }
    this.configureEditor();
    await this.loadActiveFile();
  }

  aboutToDisappear(): void {
    this.cancelPendingSuggestion();
    this.editorController.dismissInlineSuggestion();
    this.demoDecorationProvider.dispose();
  }

  build() {
    Column() {
      Column() {
        this.buildHeader()
      }
      .width('100%')

      if (this.searchVisible) {
        this.buildSearchPanel()
      }

      Column() {
        SweetEditor({ controller: this.editorController })
          .layoutWeight(1)
          .width('100%')
      }
      .layoutWeight(1)
      .width('100%')
      .padding(1)
      .backgroundColor(this.panelColor())
    }
    .height('100%')
    .width('100%')
    .padding({ top: this.topPadding + 10, bottom: 12 })
    .backgroundColor(this.pageBackgroundColor())
  }

  @Builder
  private buildHeader(): void {
    Column() {
      Row() {
        Column() {
          Text('SweetEditor OHOS')
            .fontSize(22)
            .fontColor(this.primaryTextColor())
            .fontWeight('700')
          Text(this.activeFileName.length > 0 ? this.activeFileName : 'OHOS demo')
            .margin({ top: 4 })
            .fontSize(12)
            .fontColor(this.secondaryTextColor())
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
          Text(this.statusMessage)
            .margin({ top: 6 })
            .fontSize(11)
            .fontColor(this.secondaryTextColor())
            .maxLines(1)
            .textOverflow({ overflow: TextOverflow.Ellipsis })
        }
        .alignItems(HorizontalAlign.Start)

        Blank()

        Text(this.isDarkTheme ? 'Dark' : 'Light')
          .fontSize(11)
          .fontColor(this.secondaryTextColor())
          .padding({ left: 10, right: 10, top: 6, bottom: 6 })
          .backgroundColor(this.panelStrongColor())
          .borderRadius(999)
      }
      .width('100%')

      Row() {
        Select(this.fileOptions.length > 0 ? this.fileOptions : [new DemoSelectOption('Loading...')])
          .selected(this.selectedFileIndex)
          .value(this.activeFileName.length > 0 ? this.activeFileName : 'Select file')
          .layoutWeight(1)
          .height(40)
          .backgroundColor(this.panelStrongColor())
          .fontColor(this.primaryTextColor())
          .borderRadius(12)
          .onSelect((index: number) => {
            if (index < 0 || index >= this.fileNames.length) {
              return;
            }
            this.selectedFileIndex = index;
            this.activeFileName = this.fileNames[index];
            void this.loadActiveFile();
          })

        Button() {
          Text(this.isDarkTheme ? '◐' : '☼')
            .fontSize(16)
            .fontColor(this.primaryTextColor())
        }
        .width(40)
        .height(40)
        .margin({ left: 8 })
        .padding(0)
        .backgroundColor(this.panelStrongColor())
        .borderRadius(12)
        .onClick(() => this.toggleTheme())

        Button() {
          Text('↶')
            .fontSize(18)
            .fontColor(this.primaryTextColor())
        }
        .width(40)
        .height(40)
        .margin({ left: 8 })
        .padding(0)
        .backgroundColor(this.panelStrongColor())
        .borderRadius(12)
        .onClick(() => this.handleUndo())

        Button() {
          Text('↷')
            .fontSize(18)
            .fontColor(this.primaryTextColor())
        }
        .width(40)
        .height(40)
        .margin({ left: 8 })
        .padding(0)
        .backgroundColor(this.panelStrongColor())
        .borderRadius(12)
        .onClick(() => this.handleRedo())

        Button() {
          Text('...')
            .fontSize(17)
            .fontColor(this.primaryTextColor())
        }
        .width(40)
        .height(40)
        .margin({ left: 8 })
        .padding(0)
        .backgroundColor(this.panelStrongColor())
        .borderRadius(12)
        .bindMenu([
          { value: 'Search', action: () => this.openSearchPanel(false) },
          { value: 'Replace', action: () => this.openSearchPanel(true) },
          { value: this.wrapModeLabel(), action: () => this.cycleWrapMode() }
        ])
      }
      .width('100%')
      .margin({ top: 12 })

      Row() {
      }
      .width('100%')
      .height(1)
      .margin({ top: 12 })
      .backgroundColor(this.chromeStrokeColor())
    }
    .width('100%')
    .padding({ left: 14, right: 14, top: 14, bottom: 12 })
    .backgroundColor(this.panelColor())
  }

  @Builder
  private buildSearchPanel(): void {
    Column() {
      Row() {
        TextInput({ text: this.searchText, placeholder: 'Find' })
          .layoutWeight(1)
          .height(36)
          .fontSize(13)
          .fontColor(this.primaryTextColor())
          .backgroundColor(this.panelStrongColor())
          .borderRadius(10)
          .onChange((value: string) => {
            this.searchText = value;
            this.performSearch();
          })

        Text(this.searchCounterText())
          .width(56)
          .fontSize(11)
          .fontColor(this.secondaryTextColor())
          .textAlign(TextAlign.Center)
          .maxLines(1)

        Button() {
          Text('↑')
            .fontSize(13)
            .fontColor(this.primaryTextColor())
        }
        .width(36)
        .height(36)
        .margin({ left: 6 })
        .padding(0)
        .backgroundColor(this.panelStrongColor())
        .borderRadius(10)
        .onClick(() => this.findPreviousSearchMatch())

        Button() {
          Text('↓')
            .fontSize(13)
            .fontColor(this.primaryTextColor())
        }
        .width(36)
        .height(36)
        .margin({ left: 6 })
        .padding(0)
        .backgroundColor(this.panelStrongColor())
        .borderRadius(10)
        .onClick(() => this.findNextSearchMatch())

        Button() {
          Text('×')
            .fontSize(14)
            .fontColor(this.primaryTextColor())
        }
        .width(36)
        .height(36)
        .margin({ left: 6 })
        .padding(0)
        .backgroundColor(this.panelStrongColor())
        .borderRadius(10)
        .onClick(() => this.closeSearchPanel())
      }
      .width('100%')

      Row() {
        Button() {
          Text('\\n')
            .fontSize(12)
            .fontColor(this.primaryTextColor())
        }
        .width(40)
        .height(36)
        .padding(0)
        .backgroundColor(this.panelStrongColor())
        .borderRadius(10)
        .onClick(() => {
          this.searchText += '\\n';
          this.performSearch();
        })

        this.buildSearchToggle('Aa', this.searchCaseSensitive, () => {
          this.searchCaseSensitive = !this.searchCaseSensitive;
          this.performSearch();
        })
        this.buildSearchToggle('Word', this.searchWholeWord, () => {
          this.searchWholeWord = !this.searchWholeWord;
          this.performSearch();
        })
        this.buildSearchToggle('.*', this.searchUseRegex, () => {
          this.searchUseRegex = !this.searchUseRegex;
          this.performSearch();
        })
      }
      .width('100%')
      .margin({ top: 6 })

      if (this.replaceVisible) {
        Row() {
          TextInput({ text: this.replaceText, placeholder: 'Replace' })
            .layoutWeight(1)
            .height(36)
            .fontSize(13)
            .fontColor(this.primaryTextColor())
            .backgroundColor(this.panelStrongColor())
            .borderRadius(10)
            .onChange((value: string) => {
              this.replaceText = value;
            })

          Button() {
            Text('\\n')
              .fontSize(12)
              .fontColor(this.primaryTextColor())
          }
          .width(40)
          .height(36)
          .margin({ left: 6 })
          .padding(0)
          .backgroundColor(this.panelStrongColor())
          .borderRadius(10)
          .onClick(() => {
            this.replaceText += '\\n';
          })

          Button() {
            Text('Replace')
              .fontSize(12)
              .fontColor(this.primaryTextColor())
          }
          .height(36)
          .margin({ left: 6 })
          .padding({ left: 10, right: 10 })
          .backgroundColor(this.panelStrongColor())
          .borderRadius(10)
          .onClick(() => this.replaceCurrentSearchMatch())

          Button() {
            Text('All')
              .fontSize(12)
              .fontColor(this.primaryTextColor())
          }
          .height(36)
          .margin({ left: 6 })
          .padding({ left: 10, right: 10 })
          .backgroundColor(this.panelStrongColor())
          .borderRadius(10)
          .onClick(() => this.replaceAllSearchMatches())
