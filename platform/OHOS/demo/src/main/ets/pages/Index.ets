        .width('100%')
        .margin({ top: 6 })
      }
    }
    .width('100%')
    .padding({ left: 14, right: 14, bottom: 10 })
    .backgroundColor(this.panelColor())
  }

  @Builder
  private buildSearchToggle(label: string, selected: boolean, action: () => void): void {
    Button() {
      Text(label)
        .fontSize(11)
        .fontColor(selected ? '#FFFFFF' : this.primaryTextColor())
    }
    .height(36)
    .margin({ left: 6 })
    .padding({ left: 8, right: 8 })
    .backgroundColor(selected ? ACCENT : this.panelStrongColor())
    .borderRadius(10)
    .onClick(() => action())
  }

  @Builder
  private buildBadge(label: string): void {
    Text(label)
      .fontSize(11)
      .fontColor(this.secondaryTextColor())
      .padding({ left: 10, right: 10, top: 5, bottom: 5 })
      .backgroundColor(this.panelStrongColor())
      .borderRadius(999)
      .margin({ right: 8 })
  }

  private configureEditor(): void {
    if (this.editorConfigured) {
      return;
    }
    this.editorConfigured = true;

    const settings = this.editorController.getSettings();
    if (!settings) {
      return;
    }

    settings.setFontFamily('monospace');
    settings.setEditorTextSize(28);
    settings.setFoldArrowMode(FoldArrowMode.AUTO);
    settings.setMaxGutterIcons(1);
    settings.setCurrentLineRenderMode(CurrentLineRenderMode.BORDER);
    settings.setWrapMode(this.selectedWrapMode);

    if (!this.decorationProviderAdded) {
      this.editorController.addDecorationProvider(this.demoDecorationProvider);
      this.decorationProviderAdded = true;
    }

    if (!this.completionProviderAdded) {
      this.editorController.addCompletionProvider(this.demoCompletionProvider);
      this.completionProviderAdded = true;
    }

    this.editorController.setInlineSuggestionListener(this.createInlineSuggestionListener());
    this.editorController.applyTheme(createDemoTheme(this.isDarkTheme));

    if (!this.subscribedEvents) {
      this.editorController.onInlayHintClick((event: InlayHintClickEvent) => {
        if (event.type === InlayType.COLOR) {
          this.statusMessage = `Color hint: 0x${event.intValue.toString(16).toUpperCase()}`;
          return;
        }
        this.statusMessage = `Inlay hint: ${event.line + 1}:${event.column + 1}`;
      });
      this.editorController.onCodeLensClick((event: CodeLensClickEvent) => {
        this.statusMessage = `CodeLens ${this.describeCodeLensCommand(event.commandId)} at line ${event.line + 1}`;
      });
      this.editorController.onCursorChanged((event: CursorChangedEvent) => {
        this.scheduleSuggestionIfAtLineEnd(event);
      });
      this.editorController.onSelectionChanged((event: SelectionChangedEvent) => {
        this.selectionActive = event.hasSelection;
        if (this.selectionActive) {
          this.cancelPendingSuggestion();
        }
      });
      this.subscribedEvents = true;
    }
  }

  private async loadFileList(): Promise<void> {
    const manager = this.getResourceManager();
    if (!manager) {
      this.applyFallbackFileList();
      return;
    }
    try {
      const files = await manager.getRawFileList(DEMO_RAWFILE_ROOT);
      const sorted = [...files].sort((a: string, b: string) => a.localeCompare(b));
      if (sorted.length === 0) {
        this.applyFallbackFileList();
      } else {
        this.fileNames = sorted;
        const options: SelectOption[] = [];
        for (let index = 0; index < sorted.length; index++) {
          options.push(new DemoSelectOption(sorted[index]));
        }
        this.fileOptions = options;
        this.selectedFileIndex = 0;
        this.activeFileName = sorted[0];
      }
    } catch (_e) {
      this.applyFallbackFileList();
    }

    if (this.editorConfigured) {
      void this.loadActiveFile();
    }
  }

  private describeCodeLensCommand(commandId: number): string {
    if (commandId === CODELENS_RUN_COMMAND_ID) {
      return '▶ Run';
    }
    if (commandId === CODELENS_DEBUG_COMMAND_ID) {
      return '◎ Debug';
    }
    return `Command#${commandId}`;
  }

  private applyFallbackFileList(): void {
    this.fileNames = [FALLBACK_FILE_NAME];
    this.fileOptions = [new DemoSelectOption(FALLBACK_FILE_NAME)];
    this.selectedFileIndex = 0;
    this.activeFileName = FALLBACK_FILE_NAME;
  }

  private async loadActiveFile(): Promise<void> {
    if (!this.editorConfigured) {
      return;
    }
    this.cancelPendingSuggestion();
    this.selectionActive = false;
    this.editorController.dismissInlineSuggestion();
    this.clearSearchState();
    const fileName = this.activeFileName.length > 0 ? this.activeFileName : FALLBACK_FILE_NAME;
    const manager = this.getResourceManager();
    let text = FALLBACK_TEXT;

    if (manager) {
      try {
        const content = await manager.getRawFileContent(`${DEMO_RAWFILE_ROOT}/${fileName}`);
        text = this.textDecoder.decodeToString(content);
      } catch (_e) {
        text = FALLBACK_TEXT;
      }
    }

    this.editorController.setLanguageConfiguration(createLanguageConfiguration(fileName));
    this.editorController.setMetadata(createDemoFileMetadata(fileName));
    this.editorController.loadDocument(Document.fromString(text));
    this.editorController.requestDecorationRefresh();
    this.statusMessage = `Loaded: ${fileName}`;
  }

  private openSearchPanel(replaceMode: boolean): void {
    this.searchVisible = true;
    this.replaceVisible = replaceMode;
    this.performSearch();
  }

  private closeSearchPanel(): void {
    this.clearSearchState();
    this.searchVisible = false;
    this.replaceVisible = false;
    this.statusMessage = 'Search closed';
  }

  private clearSearchState(): void {
    this.editorController.clearSearch();
    this.searchState = createEmptySearchState();
  }

  private performSearch(): void {
    if (!this.searchVisible) {
      return;
    }
    const pattern = this.decodeNewlineTokens(this.searchText);
    if (pattern.length === 0) {
      this.clearSearchState();
      return;
    }

    const request = new SearchRequest();
    request.pattern = pattern;
    request.options = {
      caseSensitive: this.searchCaseSensitive,
      wholeWord: this.searchWholeWord,
      useRegex: this.searchUseRegex,
      wrapAround: true,
      maxMatches: 10000
    };
    this.editorController.search(request);
    this.refreshSearchState();
    if (this.searchState.status === SearchStatus.FAILED) {
      this.statusMessage = this.searchState.errorMessage.length > 0 ? this.searchState.errorMessage : 'Search failed';
    }
  }

  private findNextSearchMatch(): void {
    if (!this.searchVisible) {
      this.openSearchPanel(false);
      return;
    }
    this.editorController.findNextSearchMatch();
    this.refreshSearchState();
  }

  private findPreviousSearchMatch(): void {
    if (!this.searchVisible) {
      this.openSearchPanel(false);
      return;
    }
    this.editorController.findPreviousSearchMatch();
    this.refreshSearchState();
  }

  private replaceCurrentSearchMatch(): void {
    if (!this.searchVisible) {
      return;
    }
    const state = this.editorController.getSearchState();
    if (this.searchText.length === 0 || state.status === SearchStatus.FAILED || !state.hasCurrentMatch) {
      return;
    }
    this.editorController.replaceCurrentSearchMatch(this.decodeNewlineTokens(this.replaceText));
    this.performSearch();
    this.statusMessage = 'Replace';
  }

  private replaceAllSearchMatches(): void {
    if (!this.searchVisible) {
      return;
    }
    const state = this.editorController.getSearchState();
    if (this.searchText.length === 0 || state.status === SearchStatus.FAILED || state.matchCount <= 0) {
      return;
    }
    const count = state.matchCount;
    this.editorController.replaceAllSearchMatches(this.decodeNewlineTokens(this.replaceText));
    this.performSearch();
    this.statusMessage = `Replaced ${count} matches`;
  }

  private refreshSearchState(): void {
    this.searchState = this.editorController.getSearchState();
  }

  private searchCounterText(): string {
    if (!this.searchVisible || this.searchText.length === 0) {
      return '';
    }
    if (this.searchState.status === SearchStatus.FAILED) {
      return 'Error';
    }
    if (this.searchState.matchCount <= 0) {
      return '0/0';
    }
    const index = this.searchState.hasCurrentMatch ? this.searchState.currentIndex + 1 : 0;
    return `${index}/${this.searchState.matchCount}`;
  }

  private decodeNewlineTokens(text: string): string {
    let decoded = '';
    for (let i = 0; i < text.length; i++) {
      const ch = text.charAt(i);
      if (ch === '\\' && i + 1 < text.length) {
        const next = text.charAt(i + 1);
        if (next === 'n') {
          decoded += '\n';
          i++;
          continue;
        }
        if (next === '\\') {
          decoded += '\\';
          i++;
          continue;
        }
      }
      decoded += ch;
    }
    return decoded;
  }

  private createInlineSuggestionListener(): InlineSuggestionListener {
    return new DemoInlineSuggestionStatusListener((message: string): void => {
      this.statusMessage = message;
    });
  }

  private scheduleSuggestionIfAtLineEnd(event: CursorChangedEvent): void {
    if (this.selectionActive) {
      this.cancelPendingSuggestion();
      return;
    }

    this.cancelPendingSuggestion();
    const doc = this.editorController.getDocument();
    if (!doc) {
      return;
    }

    const line = event.cursorPosition.line;
    const column = event.cursorPosition.column;
    const lineText = doc.getLineText(line);
    if (!lineText || column !== lineText.length || lineText.trim().length === 0) {
      return;
    }

    this.pendingSuggestionTimerId = setTimeout(() => {
      this.pendingSuggestionTimerId = -1;
      if (this.selectionActive || this.editorController.isInlineSuggestionShowing()) {
        return;
      }
      this.editorController.showInlineSuggestion(new InlineSuggestion(line, column, DEMO_INLINE_SUGGESTION_TEXT));
    }, INLINE_SUGGESTION_DELAY_MS);
  }

  private cancelPendingSuggestion(): void {
    if (this.pendingSuggestionTimerId >= 0) {
      clearTimeout(this.pendingSuggestionTimerId);
      this.pendingSuggestionTimerId = -1;
    }
  }

  private handleUndo(): void {
    if (!this.editorController.canUndo()) {
      this.statusMessage = 'Nothing to undo';
      return;
    }
    this.editorController.undo();
    this.statusMessage = 'Undo';
  }

  private handleRedo(): void {
    if (!this.editorController.canRedo()) {
      this.statusMessage = 'Nothing to redo';
      return;
    }
    this.editorController.redo();
    this.statusMessage = 'Redo';
  }

  private toggleTheme(): void {
    this.isDarkTheme = !this.isDarkTheme;
    this.editorController.applyTheme(createDemoTheme(this.isDarkTheme));
    this.statusMessage = this.isDarkTheme ? 'Dark theme' : 'Light theme';
  }

  private cycleWrapMode(): void {
    const wrapModes: WrapMode[] = [WrapMode.NONE, WrapMode.CHAR_BREAK, WrapMode.WORD_BREAK];
    const index = wrapModes.indexOf(this.selectedWrapMode);
    this.selectedWrapMode = wrapModes[(index + 1) % wrapModes.length];
    const settings = this.editorController.getSettings();
    if (settings) {
      settings.setWrapMode(this.selectedWrapMode);
    }
    this.statusMessage = `WrapMode: ${this.wrapModeLabel()}`;
  }

  private wrapModeLabel(): string {
    switch (this.selectedWrapMode) {
      case WrapMode.CHAR_BREAK:
        return 'Wrap: Char';
      case WrapMode.WORD_BREAK:
        return 'Wrap: Word';
      default:
        return 'Wrap: None';
    }
  }

  private getResourceManager(): resourceManager.ResourceManager | null {
    const hostContext = this.getUIContext().getHostContext();
    if (!hostContext) {
      return null;
    }
    return (hostContext as HostContextWithResourceManager).resourceManager;
  }

  private pageBackgroundColor(): string {
    return this.isDarkTheme ? DARK_PAGE_BG : LIGHT_PAGE_BG;
  }

  private panelColor(): string {
    return this.isDarkTheme ? DARK_PANEL : LIGHT_PANEL;
  }

  private panelStrongColor(): string {
    return this.isDarkTheme ? DARK_PANEL_STRONG : LIGHT_PANEL_STRONG;
  }

  private primaryTextColor(): string {
    return this.isDarkTheme ? DARK_TEXT_PRIMARY : LIGHT_TEXT_PRIMARY;
  }

  private secondaryTextColor(): string {
    return this.isDarkTheme ? DARK_TEXT_SECONDARY : LIGHT_TEXT_SECONDARY;
  }

  private chromeStrokeColor(): string {
    return this.isDarkTheme ? DARK_BORDER : LIGHT_BORDER;
  }

  private wrapButtonColor(): string {
    return this.selectedWrapMode === WrapMode.NONE ? this.panelStrongColor() : ACCENT;
  }
}
