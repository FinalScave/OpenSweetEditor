<Project>
  <PropertyGroup>
    <_SweetEditorAvaloniaRepoRoot>$(MSBuildThisFileDirectory)..\..\</_SweetEditorAvaloniaRepoRoot>
    <_SweetEditorAvaloniaTargetPlatform Condition="'$(TargetFramework)' != ''">$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)'))</_SweetEditorAvaloniaTargetPlatform>
    <_SweetEditorAvaloniaIsExecutable Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">true</_SweetEditorAvaloniaIsExecutable>
    <_SweetEditorAvaloniaMacDylib Condition="'$(RuntimeIdentifier)' == 'osx-x64'">$(_SweetEditorAvaloniaRepoRoot)prebuilt\macos\x86_64\libsweeteditor.dylib</_SweetEditorAvaloniaMacDylib>
    <_SweetEditorAvaloniaMacDylib Condition="'$(_SweetEditorAvaloniaMacDylib)' == ''">$(_SweetEditorAvaloniaRepoRoot)prebuilt\macos\arm64\libsweeteditor.dylib</_SweetEditorAvaloniaMacDylib>
    <_SweetEditorAvaloniaIosXcframeworkArchive>$(_SweetEditorAvaloniaRepoRoot)prebuilt\ios\SweetEditorCoreIOS.xcframework.zip</_SweetEditorAvaloniaIosXcframeworkArchive>
    <_SweetEditorAvaloniaIosNativeRoot>$(IntermediateOutputPath)sweeteditor-native\ios\</_SweetEditorAvaloniaIosNativeRoot>
    <_SweetEditorAvaloniaIosXcframework>$(_SweetEditorAvaloniaIosNativeRoot)SweetEditorCoreIOS.xcframework</_SweetEditorAvaloniaIosXcframework>
  </PropertyGroup>

  <ItemGroup Condition="'$(_SweetEditorAvaloniaIsExecutable)' == 'true' and '$(_SweetEditorAvaloniaTargetPlatform)' == 'macos'">
    <NativeReference Include="$(_SweetEditorAvaloniaMacDylib)"
                     Condition="Exists('$(_SweetEditorAvaloniaMacDylib)')">
      <Kind>Dynamic</Kind>
      <IsCxx>true</IsCxx>
    </NativeReference>
  </ItemGroup>

  <ItemGroup Condition="'$(_SweetEditorAvaloniaIsExecutable)' == 'true' and '$(_SweetEditorAvaloniaTargetPlatform)' == 'ios'">
    <NativeReference Include="$(_SweetEditorAvaloniaIosXcframework)"
                     Condition="Exists('$(_SweetEditorAvaloniaIosXcframeworkArchive)')">
      <Kind>Framework</Kind>
      <IsCxx>true</IsCxx>
      <SmartLink>true</SmartLink>
    </NativeReference>
  </ItemGroup>

  <Target Name="_SweetEditorAvaloniaExtractIosXcframework"
          BeforeTargets="_ExpandNativeReferences"
          Condition="'$(_SweetEditorAvaloniaIsExecutable)' == 'true' and '$(_SweetEditorAvaloniaTargetPlatform)' == 'ios' and Exists('$(_SweetEditorAvaloniaIosXcframeworkArchive)')"
          Inputs="$(_SweetEditorAvaloniaIosXcframeworkArchive)"
          Outputs="$(_SweetEditorAvaloniaIosXcframework)\Info.plist">
    <RemoveDir Directories="$(_SweetEditorAvaloniaIosNativeRoot)" />
    <MakeDir Directories="$(_SweetEditorAvaloniaIosNativeRoot)" />
    <Microsoft.Build.Tasks.Unzip SourceFiles="$(_SweetEditorAvaloniaIosXcframeworkArchive)"
                                 DestinationFolder="$(_SweetEditorAvaloniaIosNativeRoot)" />
  </Target>
</Project>
