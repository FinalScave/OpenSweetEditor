<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SweetEditor.Avalonia.Demo.Desktop</AssemblyName>
    <RootNamespace>SweetEditor.Avalonia.Demo.Desktop</RootNamespace>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Demo.Shared\Demo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\prebuilt\windows\x64\sweeteditor.dll"
          Condition="Exists('..\..\..\prebuilt\windows\x64\sweeteditor.dll') AND ('$(RuntimeIdentifier)' == '' OR $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win')))"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\prebuilt\linux\x86_64\libsweeteditor.so"
          Condition="Exists('..\..\..\prebuilt\linux\x86_64\libsweeteditor.so') AND ('$(RuntimeIdentifier)' == '' OR '$(RuntimeIdentifier)' == 'linux-x64')"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\prebuilt\linux\aarch64\libsweeteditor.so"
          Condition="Exists('..\..\..\prebuilt\linux\aarch64\libsweeteditor.so') AND '$(RuntimeIdentifier)' == 'linux-arm64'"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\prebuilt\macos\arm64\libsweeteditor.dylib"
          Condition="Exists('..\..\..\prebuilt\macos\arm64\libsweeteditor.dylib') AND ('$(RuntimeIdentifier)' == '' OR '$(RuntimeIdentifier)' == 'osx-arm64')"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\prebuilt\macos\x86_64\libsweeteditor.dylib"
          Condition="Exists('..\..\..\prebuilt\macos\x86_64\libsweeteditor.dylib') AND '$(RuntimeIdentifier)' == 'osx-x64'"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
