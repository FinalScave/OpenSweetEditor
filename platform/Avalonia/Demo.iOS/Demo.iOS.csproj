<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-ios26.5</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SweetEditor.Avalonia.Demo.iOS</AssemblyName>
    <RootNamespace>SweetEditor.Avalonia.Demo.iOS</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ApplicationId>com.qiplat.sweeteditor.avalonia.demo.ios</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <SweetEditorRepoRoot>$(MSBuildThisFileDirectory)..\..\..\</SweetEditorRepoRoot>
    <SweetEditorIosXcframeworkArchive>$(SweetEditorRepoRoot)prebuilt\ios\SweetEditorCoreIOS.xcframework.zip</SweetEditorIosXcframeworkArchive>
    <SweetEditorIosNativeRoot>$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\sweeteditor-native\ios\</SweetEditorIosNativeRoot>
    <SweetEditorIosXcframework>$(SweetEditorIosNativeRoot)SweetEditorCoreIOS.xcframework</SweetEditorIosXcframework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>true</Optimize>
    <MtouchLink>None</MtouchLink>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <MtouchLink>Full</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.iOS" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Demo.Shared\Demo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="$(SweetEditorIosXcframework)"
                     Condition="Exists('$(SweetEditorIosXcframeworkArchive)')">
      <Kind>Framework</Kind>
      <IsCxx>true</IsCxx>
      <SmartLink>true</SmartLink>
    </NativeReference>
  </ItemGroup>

  <Target Name="ExtractSweetEditorIosXcframework"
          BeforeTargets="_ExpandNativeReferences"
          Condition="Exists('$(SweetEditorIosXcframeworkArchive)')"
          Inputs="$(SweetEditorIosXcframeworkArchive)"
          Outputs="$(SweetEditorIosXcframework)\Info.plist">
    <RemoveDir Directories="$(SweetEditorIosNativeRoot)" />
    <MakeDir Directories="$(SweetEditorIosNativeRoot)" />
    <Microsoft.Build.Tasks.Unzip SourceFiles="$(SweetEditorIosXcframeworkArchive)"
                                 DestinationFolder="$(SweetEditorIosNativeRoot)" />
  </Target>

</Project>
